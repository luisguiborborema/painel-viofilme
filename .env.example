# ============================================================================
# PAINEL VIOFILME — variáveis de ambiente
# Copie para .env.local e preencha. Sem isto, o painel roda em MODO DEMO.
# ============================================================================

# --- Supabase (autenticação + banco) ---------------------------------------
# Encontre em: app.supabase.com → seu projeto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Chave de serviço (somente no servidor — NUNCA exponha no cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Meta Graph API (Instagram + Facebook) ---------------------------------
# Crie um app em https://developers.facebook.com/ (tipo "Business")
NEXT_PUBLIC_META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# URL pública do app (usada no redirect do OAuth da Meta)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Versão da Graph API
META_GRAPH_VERSION=v21.0

# --- IA (Bruna + insights automáticos via OpenAI) --------------------------
# Usada apenas no servidor (rotas /api/chat e /api/insights). Sem ela, a Bruna
# e os blocos de insight caem no fallback (modo demonstração).
OPENAI_API_KEY=sk-...
# Modelo da OpenAI (opcional). Padrão: gpt-4o-mini. Para mais qualidade: gpt-4o.
OPENAI_MODEL=gpt-4o-mini

# --- Sincronização Meta → Supabase (cron) ----------------------------------
# Segredo que protege a rota /api/meta/sync. O Vercel Cron envia
# "Authorization: Bearer <CRON_SECRET>" na chamada agendada (vercel.json).
# Gere um valor aleatório forte (ex.: `openssl rand -hex 32`).
CRON_SECRET=troque-por-um-valor-aleatorio-forte

# --- Notificações push (Web Push / VAPID) ----------------------------------
# Gere com `npx web-push generate-vapid-keys`. A pública vai no cliente.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Habilita os alertas do cron que hoje lêem dados de demonstração
# (churn, banco de horas, tarefas). Deixe "false" até ligar dados reais.
NOTIFY_MOCK_ALERTS=false

# --- Financeiro: Asaas ------------------------------------------------------
# Token que você define na config do webhook do Asaas; ele o envia no header
# `asaas-access-token`. O sistema valida antes de gravar.
ASAAS_WEBHOOK_TOKEN=
# Chave da API Asaas (para consultas/backfill de saída — opcional por enquanto).
ASAAS_API_KEY=
# Ambiente: "sandbox" (testes) ou "production".
ASAAS_ENV=sandbox

# --- Google Calendar (agenda da agência) -----------------------------------
# Crie um OAuth client ID (Web application) em console.cloud.google.com e
# habilite a "Google Calendar API". Redirect URI autorizada:
#   {NEXT_PUBLIC_APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Calendário a usar (padrão: primary do e-mail conectado).
GOOGLE_CALENDAR_ID=primary

# --- WhatsApp: Uazapi ------------------------------------------------------
# Base do servidor Uazapi e token da instância conectada.
UAZAPI_URL=https://xxxx.uazapi.com
UAZAPI_TOKEN=
# Números que recebem os alertas INTERNOS da equipe (DDI+DDD, separados por
# vírgula). Ex.: 5527999998888,5531988887777
UAZAPI_NOTIFY_NUMBERS=
# Autoriza o webhook de ENTRADA (inbox ao vivo). O Uazapi NÃO preserva query
# string, mas envia o `token` da instância no corpo — então defina este valor
# IGUAL ao token da instância que aparece no payload (campo "token"). Também
# aceita ?secret=ESTE_VALOR na URL. Deixe vazio para não validar.
UAZAPI_WEBHOOK_SECRET=
